# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-android/
dist-ios/
web-build/
expo-env.d.ts

# Any other `expo export` output directory (dist-verify, dist-envcheck, ...).
# These are multi-megabyte build artifacts and must never be committed.
dist-*/

# Local env
.env
.env*.local

# Disposable test-account email written by the local auth/integration runs. It is
# a real inbox address, so it must never be committed. Root-anchored so it
# cannot reach anything under src/ or assets/.
/.test-email.txt

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Device/UI verification artifacts written by tools/ui.ps1 (uiautomator dumps,
# screenshots, token/result scratch files). Every pattern is root-anchored on
# purpose: a bare `*.xml` or `*.png` would also match AndroidManifest.xml, the
# res/ drawables, and everything under assets/. Give a capture the `_` prefix
# (e.g. _shot1.png) and it lands here instead of in `git status`.
/_*.xml
/_*.png
/_*.txt
/_*.json
/.shot-*.png

# Dev-server / run logs from the local Expo and native build commands
/.metro*.log
/.run-android*.log

# Local Gradle and IDE state
/.gradle/
/.idea/
/build/

# JVM crash logs and JIT replay files. The Gradle daemon writes these into the
# project root when it dies (e.g. "insufficient memory for the Java Runtime
# Environment"), and they are several MB each.
/hs_err_pid*.log
/replay_pid*.log

# Stray Android Studio project sitting in the repo root. It is a standalone
# Jetpack Compose app, not this one: its applicationId is com.example.mahaa
# while app.json declares android.package "com.mahajob.mobile", it has no
# react-native or expo dependency, and it carries Android Studio wizard assets
# (BakingScreen.kt, baked_goods_*.jpg). It is unrelated to the Expo app, whose
# native project belongs under /android. It also holds a live Firebase config
# (app/google-services.json) and a machine-specific local.properties, so it must
# stay out of the index. These patterns are root-anchored so they cannot reach
# the real route tree in src/app/.
/app/
/build.gradle.kts
/settings.gradle.kts
/gradlew
/gradlew.bat
/gradle/
/gradle.properties
/local.properties

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
