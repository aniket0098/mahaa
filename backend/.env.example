# Mahaa backend — environment template.
#
# Copy to `backend/.env` and fill in. NEVER commit the real `.env`: it is
# gitignored. Every value here is a placeholder except where a default is
# genuinely safe.

# --- runtime -----------------------------------------------------------------
APP_NAME="Mahaa API"
APP_VERSION="0.1.0"
# development | test | production
# `production` turns on the fail-closed checks: a placeholder DATABASE_URL or
# DEBUG=true stops the service from starting rather than failing per request.
APP_ENV=development
DEBUG=false

# --- database ----------------------------------------------------------------
# The driver is psycopg 3. A bare postgresql:// is accepted and rewritten to
# postgresql+psycopg:// by the config validator.
# On Render this is supplied automatically by the Blueprint's `fromDatabase`
# reference — do not type a connection string there.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mahaa

# --- server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Exact origins, comma separated, never a wildcard. Leave empty locally.
CORS_ORIGINS=
