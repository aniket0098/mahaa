# Mahaa backend — environment template.
#
# Copy to `backend/.env` and fill in. NEVER commit the real `.env`: it is
# gitignored. Every value here is a placeholder except where a default is
# genuinely safe.

# --- runtime -----------------------------------------------------------------
APP_NAME="Mahaa API"
APP_VERSION="0.1.0"
# development | test | production
# `production` turns on the fail-closed checks: a placeholder DATABASE_URL or
# DEBUG=true stops the service from starting rather than failing per request.
APP_ENV=development
DEBUG=false

# --- database ----------------------------------------------------------------
# The driver is psycopg 3. A bare postgresql:// is accepted and rewritten to
# postgresql+psycopg:// by the config validator.
#
# On Render this is set in the dashboard as a `sync: false` variable; it is NOT
# supplied by the Blueprint and there is no `fromDatabase` reference any more
# (the old Render-managed database was deleted). Locally, point it at a local
# development PostgreSQL — never at production.
#
# Phase 1 needs the `citext` extension, which `alembic upgrade head` creates.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mahaa

# --- server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Exact origins, comma separated, never a wildcard.
#
# NOT empty locally: the Expo web dev server and this API are different origins
# (the app on :808x, the API on :8000), so the browser treats every call as
# cross-origin and blocks it without an exact allow-list entry. A failing login
# with no server-side log is the symptom.
#
# Expo picks the next free port when 8081 is taken, so list the few it can pick.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085

# --- authentication ----------------------------------------------------------
# `APP_ENV=production` REFUSES TO START unless JWT_SECRET is a real value of at
# least 32 characters. A placeholder, an empty string, a short string, or
# `JWT_ALGORITHM=none` all stop the service from booting — a deploy signing with
# a public key is worse than a deploy that never comes up.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
# Pinned on purpose. The `alg` header of an incoming token is never trusted; an
# unpinned decoder accepts `alg: none` and is open to algorithm confusion.
JWT_ALGORITHM=HS256
# Access-token lifetime. V1 has no refresh token, so this IS the session: sign in
# again when it lapses. 60 minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Both are verified on every decode, so a token minted for another service — or
# another environment of this one — is rejected rather than trusted.
JWT_ISSUER=mahaa-api
JWT_AUDIENCE=mahaa-mobile

# --- rate limiting -----------------------------------------------------------
# Per client IP, per sliding window, on /auth/signup and /auth/login.
#
# HONEST LIMITATION: these counters live in this process's memory. They reset on
# every deploy and are per-instance, so on Render Free — which spins down and can
# run more than one instance — this is a speed bump, not a guarantee. A shared
# store (Redis) is the real fix and is still open. Until then the failure mode
# when this is wrong is "the limiter forgot a counter", never "auth broke".
#
# Client identity is the connection's peer address, NOT a forwarded header:
# trusting X-Forwarded-For without a trusted-proxy list would let a caller
# spoof the key and bypass the limiter entirely.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_WINDOW=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60


# --- push notifications (Phase 4, §13.5) -------------------------------------
# Expo Push Service access token. OPTIONAL: leave it empty and push delivery is
# skipped with a logged warning, while notifications are still created and still
# delivered over the WebSocket. Set it only on the server -- it is a credential,
# it is never returned by an API, and it must never reach the mobile bundle.
# Obtain it from the Expo dashboard, or omit it entirely if you have not yet
# linked an EAS project.
EXPO_ACCESS_TOKEN=
