# MahaJob mobile app — local environment (copy to `.env` and adjust).
#
# EXPO_PUBLIC_* values are inlined into the JavaScript bundle at build time, so
# this file must contain PUBLIC values only. Never put a backend secret here
# (docs/SECURITY.md).

# Base URL of the existing FastAPI backend, including the /api/v1 prefix.
#
#   Android emulator : the host machine is 10.0.2.2 (localhost is the emulator)
#   Browser (web)    : localhost — see EXPO_PUBLIC_API_BASE_URL_WEB below
#   iOS simulator     : localhost (the simulator shares the host loopback)
#   Physical device   : use your computer's LAN IP, e.g. http://192.168.1.5:8000/api/v1
#
# When this variable is unset the app falls back to the correct default for the
# current platform (see `src/lib/apiBaseUrl.ts`).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Overrides the value above on the web platform only.
#
# Expo loads only `.env`, `.env.local` and `.env.<mode>` — there are no
# per-platform env files — so the browser gets its own variable. A web page
# served from http://localhost:8081 runs on this machine, so the API is
# `localhost:8000`; `10.0.2.2` is the Android emulator's alias for the host and
# is unroutable from a desktop browser, which is what made the web login screen
# time out. Android and iOS ignore this variable.
EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:8000/api/v1

# Overrides the value above on a PHYSICAL Android device only, and only when it
# is a real IPv4 LAN address (a loopback or 10.0.2.2 value here is ignored, since
# honouring it would put the phone right back where it started).
#
# A phone cannot use `localhost` (that is the phone itself) or `10.0.2.2` (that is
# the emulator's alias for a dev machine), and it is the one target the shared
# variable above cannot serve. This gives it a value of its own, so testing on a
# phone no longer requires editing the emulator's setting and breaking it.
#
# Find your address with `ipconfig` and use the Wi-Fi adapter's IPv4 — NOT the
# WSL, Hyper-V or VirtualBox adapters, which are also in a private range. Then
# start the backend so a phone can reach it at all:
#   C:\mahajob\run-mahajob.bat --lan
# and restart the dev server with `npm run start:clear` so the value is inlined.
#
# Public value only; no backend secret belongs in this file.
EXPO_PUBLIC_API_BASE_URL_LAN=http://10.236.127.87:8000/api/v1
