# Mahaa Message service — local development environment.
#
# Copy to `.env` (git-ignored) or export these in your shell. NO SECRET BELONGS
# IN THIS FILE: the committed values below are safe local defaults, and real
# credentials (Neon's DATABASE_URL, the production JWT_SECRET) live only in
# Render's environment for `message-docker-service` — never in this repo.
#
# `JWT_SECRET`, `JWT_ISSUER` and `JWT_AUDIENCE` must MATCH the main backend's
# values (backend/.env locally, Render's environment in production): the app
# signs in once against mahaa-backend-docker and presents that same token here.

# --- database ---------------------------------------------------------------
# Two local options, pick one and keep it consistent:
#
# 1. The message service's own isolated Compose stack (recommended):
#    cd message-service && docker compose up --build
#    → db is `db:5432` in-container, or 127.0.0.1:5435 from the host.
#
# 2. The main backend's Docker Compose postgres on host port 5434:
#      postgresql+psycopg://mahaa:mahaa_local_dev@localhost:5434/mahaa
#    (or whatever backend/.env points at — keep the two identical or the
#    service will read an empty users table).
#
# Inside a container the host is the compose service name (`db` / `postgres`),
# never `localhost`. docker-compose.yml sets DATABASE_URL explicitly so a
# stray value here can never point the Compose stack at another database.
DATABASE_URL=postgresql+psycopg://msgsvc:msgsvc_local_dev@127.0.0.1:5435/msgsvc

# --- authentication ---------------------------------------------------------
# Development placeholder, matching backend/.env.example. Production refuses to
# boot on this exact value (fail-closed in app/core/config.py).
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=mahaa-api
JWT_AUDIENCE=mahaa-mobile

# --- runtime ----------------------------------------------------------------
APP_ENV=development
DEBUG=true
# Render injects PORT; 8001 keeps this service beside the main API's 8000.
PORT=8001
# Exact origins, comma separated, never '*'. The mobile app sends no Origin
# header, so an empty value is correct for local mobile development.
CORS_ORIGINS=

# --- logging and request limits ---------------------------------------------
# Optional. Unset, LOG_LEVEL derives from DEBUG (DEBUG=true -> DEBUG, else
# INFO). Set one of DEBUG|INFO|WARNING|ERROR|CRITICAL to pin it explicitly; an
# unknown value is refused at startup.
LOG_LEVEL=
# Largest request body accepted, in bytes (default 65536). Every real payload
# is `{recipient_id, note?}`, so this is generous; a larger declared body is
# refused with 413 before it is read into memory.
MAX_BODY_BYTES=

# =============================================================================
# PRODUCTION (Render) - set these in the platform's secret store, NEVER here.
# Copy the NAMES, supply your own VALUES, and do not commit them.
#
#   APP_ENV=production
#   DEBUG=false
#   DATABASE_URL=<Neon pooled connection, e.g. postgresql+psycopg://...>
#   JWT_SECRET=<a fresh >=32-char secret, shared with mahaa-backend-docker>
#   CORS_ORIGINS=<exact browser origins, or empty for mobile-only>
#
# APP_ENV=production is fail-closed (app/core/config.py): it refuses to boot on
# the placeholder JWT_SECRET above, a short secret, DEBUG=true, a wildcard
# origin, or the placeholder DATABASE_URL. That is intended - fix the setting,
# never the guard.
# =============================================================================