{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://mahaa-backend.onrender.com/api/v1",
        "EXPO_PUBLIC_API_BASE_URL_LAN": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://mahaa-backend.onrender.com/api/v1",
        "EXPO_PUBLIC_API_BASE_URL_LAN": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
